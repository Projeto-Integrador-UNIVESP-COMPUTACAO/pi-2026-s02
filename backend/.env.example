# ===== Django =====
# Gere uma chave nova em produção e nunca versione o arquivo .env.
DJANGO_SECRET_KEY=django-insecure-troque-esta-chave-em-producao
DJANGO_DEBUG=True
# Hosts separados por vírgula (sem espaços).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,.onrender.com

# ===== CORS (frontend Angular) =====
# Em produção, prefira False e liste as origens permitidas abaixo.
DJANGO_CORS_ALLOW_ALL_ORIGINS=True
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
DJANGO_CORS_ALLOW_CREDENTIALS=True

# ===== PostgreSQL =====
DB_NAME=pi02-db
DB_USER=pi02-user
DB_PASSWORD=pi02
DB_HOST=localhost
DB_PORT=5432
